# =============================================
# ENV VARS - Isi di Vercel Dashboard > Settings > Environment Variables
# =============================================

# MongoDB
MY_MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/dbname

# Domain
MY_DOMAIN_URL=yourdomain.vercel.app
MY_DOMAIN_VERCEL=yourdomain.vercel.app
MY_DOMAIN_KOYEB=yourdomain.koyeb.app

# Auth
MY_PASSWORD=your_admin_password
MY_NEXTAUTH_SECRET=your_random_secret_32chars
NEXTAUTH_SECRET=your_random_secret_32chars
NEXTAUTH_URL=https://yourdomain.vercel.app

# OAuth (optional)
MY_GOOGLE_CLIENT_ID=
MY_GOOGLE_CLIENT_SECRET=
MY_GITHUB_ID=
MY_GITHUB_SECRET=

# API Keys (optional)
MY_SONIVA_KEY=
MY_SUNOAPI_KEY=

# Rate Limiting
MY_LIMIT_POINTS=30
MY_LIMIT_DURATION=60
